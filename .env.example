# Copy this file to .env.local for local dev, .env.production for prod builds.
# Never commit files with real values.

# Google reCAPTCHA v3 site key (public — safe to expose)
VITE_RECAPTCHA_SITE_KEY=

# Sentry DSN — get from sentry.io > Project > Settings > Client Keys
# Leave blank to disable Sentry (errors are silently ignored)
VITE_SENTRY_DSN=

# Optional: tag Sentry errors with a release version (e.g. git SHA)
# VITE_RELEASE=
